# Account-specific config (session source, machine paths) — never committed.
config.toml

# Captured browser sessions (contain cookies) — never committed.
session.curl
*.curl
cookies.txt

# Raw API captures the fixture scrubber reads. Every row carries an entitlement id, so
# these never go in; testdata/store holds the scrubbed output instead.
captures/

# A project manifest and its lockfile belong with the consuming project, not this tool
# repo; ignored here defensively so running the tool from this directory never commits
# them (the committed unity-sync.example.toml is not matched by the exact name).
unity-sync.toml
unity-sync.lock.json

# Built binaries. Named rather than globbed: `go build ./cmd/scrubfixtures` writes
# ./scrubfixtures into the working directory, and a 6.8 MB artifact stays in history
# for good once it is committed.
/unity-sync
/scrubfixtures
/dist/
